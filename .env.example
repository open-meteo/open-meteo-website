# Cloudflare R2 asset store — used by `npm run assets:push` (maintainers only).
# Pulls use the public ASSETS_BASE_URL and need no credentials.
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=static-assets
# Public read base URL of the bucket (r2.dev or custom domain), no trailing slash
ASSETS_BASE_URL=https://static-assets.open-meteo.com

# Stripe Payment Links of the pricing page, one per price (see src/env.ts).
# Unset links render the subscribe buttons disabled.
STRIPE_LINK_STANDARD_MONTH=
STRIPE_LINK_STANDARD_YEAR=
STRIPE_LINK_PROFESSIONAL_MONTH=
STRIPE_LINK_PROFESSIONAL_YEAR=
STRIPE_LINK_PROFESSIONAL_10M_MONTH=
STRIPE_LINK_PROFESSIONAL_10M_YEAR=
