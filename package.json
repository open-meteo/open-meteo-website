{
	"name": "open-meteo-website",
	"type": "module",
	"author": "Open-Meteo <info@open-meteo.com>",
	"private": true,
	"version": "1.60.5",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/open-meteo/open-meteo-website.git"
	},
	"description": "This package contains the Open-Meteo website",
	"scripts": {
		"dev": "svelte-kit sync && vite dev --host",
		"prebuild": "node scripts/assets.mjs pull",
		"build": "svelte-kit sync && vite build -l info",
		"prebuild-weather": "node scripts/assets.mjs pull",
		"build-weather": "BUILD_WEATHER_PAGES=true svelte-kit sync && BUILD_WEATHER_PAGES=true vite build -l info",
		"staging": "NODE_ENV=development vite build --mode development",
		"preview": "vite preview --host",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"backgrounds": "node scripts/backgrounds.mjs",
		"domain-grids": "node --disable-warning=ExperimentalWarning scripts/domain-grids.mjs",
		"assets:pull": "node scripts/assets.mjs pull",
		"assets:push": "node scripts/assets.mjs push",
		"lint": "prettier --check . && eslint .",
		"test": "vitest",
		"coverage": "vitest run --coverage",
		"format": "prettier --write .",
		"rename_index_files": "node scripts/rename_to_index_html.js",
		"update-components": "node scripts/update-shadcn.mjs",
		"build:preview": "npm run build && npm run preview"
	},
	"devDependencies": {
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.73.0",
		"@poppanator/sveltekit-svg": "^7.0.1",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/load-config": "^0.2.2",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.5",
		"@trivago/prettier-plugin-sort-imports": "^6.0.2",
		"@types/node": "^26.6.6",
		"@vitest/coverage-v8": "^5.1.0",
		"bits-ui": "^2.21.0",
		"clsx": "^2.1.1",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"highcharts": "13.1.1",
		"mdsvex": "^0.12.8",
		"mode-watcher": "^1.1.0",
		"openmeteo": "^1.2.3",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^3.5.2",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"rollup-plugin-visualizer": "^7.1.3",
		"shadcn-svelte": "^1.8.1",
		"shiki": "^4.6.0",
		"simple-icons": "^16.38.0",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"svelte-persisted-store": "^0.12.0",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^4.0.2",
		"tailwindcss": "^4.0.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.2",
		"vite": "^8.3.8",
		"vitest": "^5.1.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
